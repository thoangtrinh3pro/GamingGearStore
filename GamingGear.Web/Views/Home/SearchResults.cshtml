@model IEnumerable<GamingGear.Domain.Entities.Product>

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    string searchQuery = ViewBag.SearchQuery as string ?? "";
}

<div class="container my-5">
    <h2 class="fw-bold mb-3">🔍 Kết quả tìm kiếm cho: <span class="text-primary">"@searchQuery"</span></h2>
    <p class="text-muted mb-4">Tìm thấy <strong>@Model.Count()</strong> sản phẩm phù hợp.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-5 shadow-sm border-0" role="alert">
            <h4 class="alert-heading fw-bold">Không tìm thấy sản phẩm nào!</h4>
            <p class="text-muted">Rất tiếc, không có thiết bị Gaming Gear nào khớp với từ khóa của bạn.</p>
            <hr>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-2">Xem toàn bộ cửa hàng</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div style="height: 180px; overflow: hidden; background: #f8f9fa;" class="d-flex align-items-center justify-content-center p-2">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/300" : item.ImageUrl)"
                                 class="card-img-top rounded" alt="@item.Name" style="max-height: 100%; object-fit: contain;">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-dark fw-bold" style="font-size: 1rem;">@item.Name</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(item.Description != null && item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="text-danger fw-bold">@item.Price.ToString("N0") đ</span>
                            </div>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark mt-3 w-100 btn-sm fw-bold">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>