@model IEnumerable<GamingGear.Domain.Entities.Product>

@{
    ViewData["Title"] = "Trang chủ - Ambition Karma Shop";
    var categories = ViewBag.Categories as IEnumerable<GamingGear.Domain.Entities.Category>;
}

<style>
    body {
        background-color: #f8fafc;
        color: #1e293b;
    }

    @@keyframes floatBanner {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-5px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .hero-banner-pro {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #090d16 100%);
        border: 1px solid #334155;
        border-radius: 1.5rem;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.3);
        position: relative;
        overflow: hidden;
        animation: floatBanner 6s ease-in-out infinite;
    }

    .feature-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

        .feature-card:hover {
            transform: translateY(-4px);
            border-color: #3b82f6;
            box-shadow: 0 12px 25px rgba(59, 130, 246, 0.1);
        }

    .feature-icon-box {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.4rem;
        background: rgba(59, 130, 246, 0.1);
        color: #2563eb;
        transition: all 0.3s ease;
    }

    .feature-card:hover .feature-icon-box {
        background: #2563eb;
        color: #ffffff;
    }

    .category-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        transition: all 0.3s ease;
    }

    .gaming-card {
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
        border-radius: 1rem;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
</style>

<!-- Hero Banner -->
<div class="p-5 mb-5 hero-banner-pro position-relative mt-3 text-white">
    <div class="row align-items-center hero-content py-3">
        <div class="col-lg-7">
            <span class="badge bg-warning text-dark px-3 py-2 mb-3 fw-bold text-uppercase tracking-wider">⚡ SIÊU THỊ GAMING GEAR 2026</span>
            <h1 class="display-4 fw-bold text-warning mb-3">Ambition Karma Shop</h1>
            <p class="fs-5 text-light opacity-85 mb-4">
                Vũ khí tối thượng cho game thủ chuyên nghiệp. Bàn phím custom nhôm CNC, chuột siêu nhẹ Esports và tai nghe chuẩn thi đấu.
            </p>
            <div class="d-flex gap-3">
                <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg px-5 py-3 fw-bold rounded-pill text-dark btn-custom">
                    🎮 KHÁM PHÁ NGAY
                </a>
            </div>
        </div>
        <div class="col-lg-5 text-center d-none d-lg-block">
            <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&q=80&w=800" alt="Pro Gaming Gear" class="img-fluid rounded-4 hero-img-pro border border-secondary border-2" style="max-height: 270px; object-fit: cover;" />
        </div>
    </div>
</div>

<!-- USP Bar -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="p-4 feature-card d-flex align-items-center gap-3 shadow-sm">
            <div class="feature-icon-box flex-shrink-0">🚀</div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Giao Hàng Siêu Tốc</h6>
                <p class="text-muted small mb-0">Miễn phí toàn quốc đơn từ 2 triệu.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 feature-card d-flex align-items-center gap-3 shadow-sm">
            <div class="feature-icon-box flex-shrink-0">🛡️</div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Chính Hãng 100%</h6>
                <p class="text-muted small mb-0">Đổi mới trong 30 ngày đầu tiên.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <!-- 🌟 LINK NÚT HỖ TRỢ CHUYÊN SÂU 24/7 SANG TRANG HỎI ĐÁP -->
        <a asp-controller="Support" asp-action="Index" class="text-decoration-none">
            <div class="p-4 feature-card d-flex align-items-center gap-3 shadow-sm">
                <div class="feature-icon-box flex-shrink-0">💬</div>
                <div>
                    <h6 class="fw-bold mb-1 text-dark">Hỗ Trợ Chuyên Sâu 24/7</h6>
                    <p class="text-muted small mb-0">Tư vấn cấu hình phím custom chuẩn.</p>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Danh mục nổi bật -->
<div class="mb-5">
    <div class="d-flex align-items-center mb-4">
        <div class="bg-primary rounded-pill me-2" style="width: 6px; height: 24px;"></div>
        <h3 class="fw-bold text-dark m-0">Danh Mục Thiết Bị</h3>
    </div>
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @if (categories != null)
        {
            @foreach (var cat in categories)
            {
                <div class="col">
                    <div class="card h-100 category-card text-center p-4 shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between p-0">
                            <div>
                                <h5 class="card-title fw-bold text-dark mb-2">@cat.Name</h5>
                                <p class="card-text text-muted small mb-4">@cat.Description</p>
                            </div>
                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id" class="btn btn-sm btn-light text-primary fw-bold border-0 rounded-pill py-2 bg-primary bg-opacity-10">Xem ngay →</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Danh sách Sản phẩm nổi bật -->
<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="bg-primary rounded-pill me-2" style="width: 6px; height: 24px;"></div>
            <h3 class="fw-bold text-dark m-0">Siêu Phẩm Nổi Bật</h3>
        </div>
        <a asp-controller="Product" asp-action="Index" class="text-decoration-none fw-bold text-primary hover-link">Xem toàn bộ kho hàng →</a>
    </div>

    <div class="row row-cols-1 row-cols-md-4 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 gaming-card shadow-sm overflow-hidden d-flex flex-column">
                        <div style="height: 200px; overflow: hidden; background: #f8f9fa;" class="position-relative d-flex align-items-center justify-content-center p-3">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/300" : item.ImageUrl)" class="card-img-top rounded" alt="@item.Name" style="max-height: 100%; object-fit: contain;">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-dark fw-bold mb-2" style="font-size: 1rem;">@item.Name</h5>
                            <p class="card-text text-muted small flex-grow-1" style="font-size: 0.85rem;">
                                @(item.Description != null && item.Description.Length > 75 ? item.Description.Substring(0, 75) + "..." : item.Description)
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light mb-2">
                                <span class="text-danger fw-bold fs-6">@item.Price.ToString("N0") đ</span>
                                @if (item.StockQuantity > 0)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1 small">
                                        Còn: @item.StockQuantity
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1 small">
                                        🚫 Hết hàng
                                    </span>
                                }
                            </div>

                            @if (item.StockQuantity > 0)
                            {
                                <div class="d-flex align-items-center justify-content-between mb-2 bg-light p-2 rounded-3 border">
                                    <span class="small text-muted fw-bold">Số lượng:</span>
                                    <input type="number" value="1" min="1" max="@item.StockQuantity" class="form-control form-control-sm text-center fw-bold bg-white" style="width: 70px;" oninput="document.getElementById('home-qty-cart-@item.Id').value = this.value; document.getElementById('home-qty-buynow-@item.Id').value = this.value;" />
                                </div>
                            }

                            <div class="d-flex gap-1 mt-auto">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark flex-fill fw-bold py-2 px-1 btn-sm rounded-pill" style="font-size: 0.78rem;">
                                    🔍 Chi tiết
                                </a>

                                @if (item.StockQuantity > 0)
                                {
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-fill">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" id="home-qty-cart-@item.Id" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-warning w-100 fw-bold py-2 px-1 btn-sm rounded-pill text-dark shadow-sm" style="font-size: 0.78rem;">
                                            🛒 Giỏ
                                        </button>
                                    </form>

                                    <form asp-controller="Cart" asp-action="BuyNow" method="post" class="flex-fill">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" id="home-qty-buynow-@item.Id" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-danger w-100 fw-bold py-2 px-1 btn-sm rounded-pill text-white shadow-sm" style="font-size: 0.78rem;">
                                            ⚡ Mua
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-secondary flex-fill fw-bold py-2 px-1 btn-sm rounded-pill" disabled style="font-size: 0.78rem;">
                                        ❌ Hết
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>