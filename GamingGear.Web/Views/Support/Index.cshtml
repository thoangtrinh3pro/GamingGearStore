@model IEnumerable<GamingGear.Domain.Entities.SupportMessage>

@{
    ViewData["Title"] = "Hỗ trợ chuyên sâu 24/7 - Ambition Karma Shop";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 mb-2 fw-bold rounded-pill text-uppercase">💬 Tư vấn & Hỗ trợ khách hàng</span>
        <h2 class="fw-bold text-dark">Hệ Thống Hỏi Đáp Trực Tuyến 24/7</h2>
        <p class="text-muted">Gửi thắc mắc về cấu hình, switch bàn phím, chính sách bảo hành hoặc vận chuyển để đội ngũ Admin hỗ trợ ngay lập tức.</p>
    </div>

    @if (TempData["SuccessSupport"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm">@TempData["SuccessSupport"]</div>
    }
    @if (TempData["ErrorSupport"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm">@TempData["ErrorSupport"]</div>
    }

    <!-- Khung gửi câu hỏi dành cho Khách / User (Không phải Admin) -->
    @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-5 bg-white">
            <h5 class="fw-bold mb-3 text-primary">✏️ Đặt câu hỏi mới cho chuyên gia</h5>
            <form asp-action="SendQuestion" method="post">
                <div class="mb-3">
                    <textarea name="question" class="form-control rounded-3" rows="3" placeholder="Nhập câu hỏi của bạn (Ví dụ: Tư vấn giúp mình phím custom nào êm, ít ồn để văn phòng?)..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary fw-bold px-4 rounded-pill">Gửi câu hỏi</button>
            </form>
        </div>
    }
    else if (!User.Identity?.IsAuthenticated ?? true)
    {
        <div class="alert alert-info rounded-4 shadow-sm mb-5">
            Vui lòng <a asp-controller="Account" asp-action="Login" class="fw-bold text-decoration-underline">Đăng nhập</a> để đặt câu hỏi trực tiếp với quản trị viên shop.
        </div>
    }

    <!-- Danh sách các câu hỏi đã hỏi -->
    <h4 class="fw-bold mb-4">📋 Lịch sử hỏi đáp cộng đồng</h4>
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-primary mb-0">👤 @item.CustomerName</h6>
                            <small class="text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <p class="text-dark fw-semibold mb-3">Q: @item.Question</p>

                        <!-- Hiển thị câu trả lời của Admin nếu có -->
                        @if (!string.IsNullOrEmpty(item.AdminReply))
                        {
                            <div class="bg-light p-3 rounded-3 border-start border-4 border-primary mt-2">
                                <small class="text-primary fw-bold">⚡ Phản hồi từ Quản trị viên Ambition Karma:</small>
                                <p class="text-secondary mb-0 mt-1">@item.AdminReply</p>
                            </div>
                        }
                        else
                        {
                            <div class="text-warning small fst-italic">⏳ Đang chờ quản trị viên phản hồi...</div>
                        }

                        <!-- Ô nhập trả lời dành riêng cho Admin -->
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <form asp-action="AdminReply" method="post" class="mt-3 pt-3 border-top">
                                <input type="hidden" name="id" value="@item.Id" />
                                <div class="input-group">
                                    <input type="text" name="adminReply" class="form-control" placeholder="Nhập câu trả lời với tư cách Admin..." value="@item.AdminReply" required />
                                    <button type="submit" class="btn btn-dark fw-bold px-4">Gửi trả lời</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted fst-italic bg-white rounded-4 border">
                Chưa có câu hỏi nào được gửi lên hệ thống. Hãy là người đầu tiên đặt câu hỏi!
            </div>
        }
    </div>
</div>