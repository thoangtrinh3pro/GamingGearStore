@model IEnumerable<GamingGear.Domain.Entities.SupportMessage>

@{
    ViewData["Title"] = "Quản lý Hỗ trợ & Tư vấn - Ambition Karma Admin";
    var pendingCount = ViewBag.PendingCount as int? ?? 0;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var currentStatus = ViewBag.CurrentStatus as string ?? "all";
}

<div class="container-fluid py-4 px-4" style="background-color: #f8fafc; min-height: 85vh;">
    <!-- Header trang quản trị -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">💬 Trung Tâm Hỗ Trợ Khách Hàng</h2>
            <p class="text-muted mb-0">Quản lý, tiếp nhận và phản hồi câu hỏi tư vấn cấu hình, thiết bị gaming từ khách hàng.</p>
        </div>
        <div>
            <a asp-controller="Support" asp-action="Index" class="btn btn-white border bg-white shadow-sm rounded-pill px-4 fw-bold text-dark">
                👁️ Xem giao diện Khách
            </a>
        </div>
    </div>

    @if (TempData["SuccessSupport"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 text-success fw-semibold bg-white border-start border-4 border-success p-3">
            ✨ @TempData["SuccessSupport"]
        </div>
    }

    <!-- Thống kê Dashboard -->
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Cần trả lời ngay</span>
                        <h2 class="fw-extrabold text-warning mt-2 mb-0 display-6">@pendingCount</h2>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        ⏳
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Đã xử lý xong</span>
                        <h2 class="fw-extrabold text-success mt-2 mb-0 display-6">@(totalCount - pendingCount)</h2>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        ✅
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 0.5px;">Tổng số câu hỏi</span>
                        <h2 class="fw-extrabold text-primary mt-2 mb-0 display-6">@totalCount</h2>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        📊
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh lọc tab chuyển đổi trạng thái -->
    <div class="d-flex gap-2 mb-4 bg-white p-2 rounded-4 shadow-sm d-inline-flex border">
        <a asp-action="AdminIndex" asp-route-status="all" class="btn @(currentStatus == "all" ? "btn-dark shadow-sm" : "btn-light text-muted border-0") rounded-pill px-4 py-2 fw-bold text-sm">
            Tất cả (@totalCount)
        </a>
        <a asp-action="AdminIndex" asp-route-status="pending" class="btn @(currentStatus == "pending" ? "btn-warning text-dark shadow-sm" : "btn-light text-muted border-0") rounded-pill px-4 py-2 fw-bold text-sm position-relative">
            Chưa trả lời
            @if (pendingCount > 0)
            {
                <span class="badge bg-danger rounded-pill ms-1">@pendingCount</span>
            }
        </a>
        <a asp-action="AdminIndex" asp-route-status="resolved" class="btn @(currentStatus == "resolved" ? "btn-success shadow-sm" : "btn-light text-muted border-0") rounded-pill px-4 py-2 fw-bold text-sm">
            Đã trả lời
        </a>
    </div>

    <!-- Danh sách câu hỏi dạng Modern Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                            <tr>
                                <th class="ps-4 py-3">Khách hàng</th>
                                <th class="py-3" style="width: 30%;">Nội dung câu hỏi</th>
                                <th class="py-3 text-center">Trạng thái</th>
                                <th class="py-3">Thời gian</th>
                                <th class="pe-4 py-3 text-end" style="width: 25%;">Thao tác / Phản hồi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(!item.IsResolved ? "bg-warning bg-opacity-10" : "")">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px; font-size: 0.9rem;">
                                                @(item.CustomerName.Length > 0 ? item.CustomerName.Substring(0, 1).ToUpper() : "U")
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.CustomerName</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">ID: @item.UserId.Substring(0, Math.Min(8, item.UserId.Length))...</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <div class="text-dark fw-semibold text-truncate" style="max-width: 320px; font-size: 0.9rem;" title="@item.Question">
                                            @item.Question
                                        </div>
                                    </td>
                                    <td class="py-3 text-center">
                                        @if (item.IsResolved)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                                ✅ Đã trả lời
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning text-dark border border-warning-subtle px-3 py-2 rounded-pill fw-bold" style="font-size: 0.75rem;">
                                                ⏳ Chờ phản hồi
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 text-muted" style="font-size: 0.85rem;">
                                        <div>@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                                        <div class="small opacity-75">@item.CreatedAt.ToString("HH:mm")</div>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <!-- Nút mở Modal Chi tiết & Sửa -->
                                        <button type="button" class="btn btn-sm btn-dark rounded-pill fw-bold px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#detailModal-@item.Id">
                                            🔍 Chi tiết & Sửa
                                        </button>
                                    </td>
                                </tr>

                                <!-- Modal Chi tiết & Phản hồi cho từng dòng -->
                                <div class="modal fade" id="detailModal-@item.Id" tabindex="-1" aria-labelledby="modalLabel-@item.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content rounded-4 border-0 shadow-lg">
                                            <div class="modal-header bg-light px-4 py-3 rounded-top-4 border-0">
                                                <h5 class="modal-title fw-bold text-dark" id="modalLabel-@item.Id">
                                                    💬 Chi tiết câu hỏi từ: <span class="text-primary">@item.CustomerName</span>
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>

                                            <form asp-action="AdminReply" method="post">
                                                <div class="modal-body p-4 text-start">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <input type="hidden" name="redirectSource" value="AdminIndex" />

                                                    <!-- Thông tin câu hỏi đầy đủ -->
                                                    <div class="mb-3">
                                                        <label class="form-label text-muted small fw-bold text-uppercase">Nội dung câu hỏi của khách:</label>
                                                        <div class="p-3 bg-light rounded-3 text-dark fw-semibold border" style="white-space: pre-wrap; line-height: 1.5;">
                                                            @item.Question
                                                        </div>
                                                        <div class="text-muted small mt-1">🕒 Gửi lúc: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</div>
                                                    </div>

                                                    <hr class="my-3 text-muted opacity-25" />

                                                    <!-- Khung chỉnh sửa câu trả lời của Admin -->
                                                    <div class="mb-3">
                                                        <label for="adminReply-@item.Id" class="form-label fw-bold text-dark">
                                                            ⚡ Câu trả lời của Quản trị viên (Có thể chỉnh sửa):
                                                        </label>
                                                        <textarea name="adminReply" id="adminReply-@item.Id" class="form-control rounded-3 shadow-sm" rows="5" placeholder="Nhập câu trả lời chi tiết cho khách hàng..." required>@item.AdminReply</textarea>
                                                    </div>
                                                </div>

                                                <div class="modal-footer bg-light px-4 py-3 rounded-bottom-4 border-0">
                                                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Đóng</button>
                                                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                                        💾 Lưu & Gửi phản hồi
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 my-4">
                    <div class="fs-1 mb-2">🎉</div>
                    <h5 class="fw-bold text-dark">Tuyệt vời!</h5>
                    <p class="text-muted small">Hiện tại không có câu hỏi nào cần xử lý trong mục này.</p>
                </div>
            }
        </div>
    </div>
</div>