@{
    ViewData["Title"] = "Đặt hàng thành công - Ambition Karma Shop";
    int orderId = ViewBag.OrderId ?? 0;
}

<div class="container my-5 text-center">
    <div class="p-5 bg-white border rounded-4 shadow-sm mx-auto" style="max-width: 600px;">
        <div class="mb-4 text-success display-1 animate__animated animate__bounceIn">
            🎉
        </div>
        <h2 class="fw-bold text-dark mb-3">Cảm Ơn Bạn Đã Mua Hàng!</h2>
        <p class="text-muted mb-3">
            Đơn hàng của bạn tại <b>Ambition Karma Shop</b> đã được ghi nhận thành công. Mã đơn hàng của bạn là:
        </p>
        <div class="mb-4">
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle fs-3 px-4 py-2 rounded-pill fw-bold">
                #@orderId
            </span>
        </div>
        <p class="text-muted small mb-4">
            Hệ thống đã tự động gửi email hóa đơn chi tiết vào hộp thư của bạn. Chúng tôi sẽ tiến hành đóng gói và giao thiết bị gaming đến bạn trong thời gian sớm nhất!
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Order" asp-action="Details" asp-route-id="@orderId" class="btn btn-primary px-4 py-3 rounded-pill fw-bold shadow-sm">
                📦 Xem Chi Tiết Đơn Hàng
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary px-4 py-3 rounded-pill fw-bold">
                🛍️ Tiếp Tục Mua Sắm
            </a>
        </div>
    </div>
</div>