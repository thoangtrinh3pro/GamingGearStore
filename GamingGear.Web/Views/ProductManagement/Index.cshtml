@model IEnumerable<GamingGear.Domain.Entities.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm - Admin";
}

<div class="container my-4">
    <!-- TIÊU ĐỀ VÀ THANH ĐIỀU HƯỚNG QUẢN TRỊ -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-3">
        <div>
            <span class="badge bg-primary px-3 py-2 mb-2 fw-bold text-uppercase">⚡ QUẢN TRỊ KHO HÀNG</span>
            <h2 class="fw-bold text-dark mb-0">Danh Sách Sản Phẩm</h2>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                ← Quay lại Dashboard
            </a>
            <!-- Nút điều hướng sang Quản lý đơn hàng -->
            <a asp-controller="AdminOrder" asp-action="Index" class="btn btn-warning rounded-pill px-4 fw-bold text-dark shadow-sm">
                📦 Quản lý đơn hàng
            </a>
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                ➕ Thêm Sản Phẩm Mới
            </a>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH SẢN PHẨM -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small">
                    <tr>
                        <th class="py-3 ps-4">Hình ảnh</th>
                        <th class="py-3">Tên sản phẩm</th>
                        <th class="py-3">Giá bán</th>
                        <th class="py-3">Tồn kho</th>
                        <th class="py-3 text-center" style="width: 200px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <img src="@item.ImageUrl" alt="@item.Name" class="rounded-3 border object-fit-cover" style="width: 50px; height: 50px;" onerror="this.src='https://via.placeholder.com/50';" />
                                </td>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-3 py-2 fw-bold">@item.StockQuantity cái</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold me-1">
                                        ✏️ Sửa
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                        🗑️ Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                Chưa có sản phẩm nào trong kho hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>