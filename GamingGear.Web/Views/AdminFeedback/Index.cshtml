@model IEnumerable<GamingGear.Domain.Entities.Feedback>

@{
    ViewData["Title"] = "Quản lý Đánh giá - Admin";
    // Thống kê số lượng feedback tệ (<= 2 sao) để thông báo cho Admin
    int badFeedbackCount = Model?.Count(f => f.Rating <= 2) ?? 0;
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">QUẢN LÝ ĐÁNH GIÁ (FEEDBACK)</h2>
        <span class="badge bg-secondary px-3 py-2 fs-6 rounded-pill">Tổng số: @(Model?.Count() ?? 0)</span>
    </div>

    <!-- KHU VỰC CẢNH BÁO NẾU CÓ FEEDBACK TỆ -->
    @if (badFeedbackCount > 0)
    {
        <div class="alert alert-danger rounded-4 shadow-sm mb-4 d-flex align-items-center gap-3" role="alert">
            <div class="fs-3">⚠️</div>
            <div>
                <strong>Cảnh báo khẩn cấp:</strong> Có tổng số <strong>@badFeedbackCount</strong> đánh giá tiêu cực ($\le 2$ sao) từ khách hàng cần được xem xét và xử lý ngay lập tức!
            </div>
        </div>
    }

    <div class="card border rounded-4 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small">
                    <tr>
                        <th class="py-3 px-4">ID</th>
                        <th class="py-3">Khách Hàng</th>
                        <th class="py-3 text-center">Đánh Giá (Sao)</th>
                        <th class="py-3">Nội Dung Feedback</th>
                        <th class="py-3">Thời Gian</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            // Kiểm tra nếu là feedback tệ (<= 2 sao) thì tô sáng dòng để Admin chú ý
                            bool isBad = item.Rating <= 2;
                            <tr class="@(isBad ? "table-danger fw-bold" : "")">
                                <td class="px-4">#@item.Id</td>
                                <td>@item.CustomerName</td>
                                <td class="text-center">
                                    <span class="badge @(isBad ? "bg-danger" : "bg-success") px-3 py-2 rounded-pill">
                                        @item.Rating ⭐
                                    </span>
                                </td>
                                <td>@item.Comment</td>
                                <td class="small text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">Chưa có đánh giá nào từ khách hàng.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>