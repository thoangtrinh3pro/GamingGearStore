@model IEnumerable<GamingGear.Domain.Entities.Order>

@{
    ViewData["Title"] = "Lịch sử & Tra cứu đơn hàng - Ambition Karma Shop";
    string searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="bg-primary rounded-pill me-2" style="width: 6px; height: 26px;"></div>
            <h2 class="fw-bold text-dark m-0">Lịch Sử & Tra Cứu Đơn Hàng</h2>
        </div>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-pill px-4">
            ← Tiếp tục mua sắm
        </a>
    </div>

    <!-- Khung tìm kiếm / tra cứu đơn hàng -->
    <div class="card border rounded-4 shadow-sm p-4 mb-4 bg-light">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-9">
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control form-control-lg rounded-pill px-4" placeholder="Nhập mã đơn hàng hoặc số điện thoại của bạn để tra cứu..." />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm">
                    🔍 Tra Cứu Ngay
                </button>
            </div>
        </form>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <strong>Thành công:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Danh sách đơn hàng -->
    <div class="card border rounded-4 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-uppercase small">
                    <tr>
                        <th class="py-3 px-4">Mã Đơn</th>
                        <th class="py-3">Người Nhận</th>
                        <th class="py-3">Số Điện Thoại</th>
                        <th class="py-3">Ngày Đặt</th>
                        <th class="py-3">Tổng Tiền</th>
                        <th class="py-3 text-center">Trạng Thái</th>
                        <th class="py-3 text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="px-4 fw-bold text-primary">#@order.Id</td>
                                <td class="fw-bold text-dark">@order.FullName</td>
                                <td>@order.PhoneNumber</td>
                                <td class="small text-muted">@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</td>
                                <td class="text-center">
                                    @switch (order.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-warning text-dark px-3 py-2 fw-semibold rounded-pill">Chờ xử lý</span>
                                            break;
                                        case "Processing":
                                            <span class="badge bg-info text-dark px-3 py-2 fw-semibold rounded-pill">Đang chuẩn bị</span>
                                            break;
                                        case "Shipped":
                                            <span class="badge bg-primary text-white px-3 py-2 fw-semibold rounded-pill">Đang giao hàng</span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-success text-white px-3 py-2 fw-semibold rounded-pill">Hoàn tất</span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-secondary text-white px-3 py-2 fw-semibold rounded-pill">Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark px-3 py-2 fw-semibold rounded-pill">@order.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark fw-bold rounded-pill px-3">
                                        Chi tiết / Hủy đơn
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">Không tìm thấy đơn hàng nào phù hợp. Vui lòng thử lại với số điện thoại hoặc mã đơn khác.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>