@model IEnumerable<GamingGear.Domain.Entities.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm - Ambition Karma Shop";
    var categories = ViewBag.Categories as IEnumerable<GamingGear.Domain.Entities.Category>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<style>
    body {
        background-color: #f8fafc;
        color: #1e293b;
    }

    /* --- SIDEBAR BỘ LỌC DANH MỤC --- */
    .filter-group .list-group-item {
        border-radius: 0.75rem !important;
        margin-bottom: 0.5rem;
        border: 1px solid #e2e8f0;
        transition: all 0.25s ease;
        font-weight: 600;
    }

        .filter-group .list-group-item.active {
            background-color: #0d6efd;
            border-color: #0d6efd;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
        }

        .filter-group .list-group-item:hover:not(.active) {
            background-color: #f1f5f9;
            transform: translateX(4px);
        }

    /* --- PRODUCT CARD --- */
    .gaming-card {
        background-color: #ffffff;
        border: 1px solid #e2e8f0 !important;
        border-radius: 1rem;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

        .gaming-card:hover {
            transform: translateY(-8px);
            border-color: #2563eb !important;
            box-shadow: 0 15px 30px rgba(37, 99, 235, 0.12);
        }

        .gaming-card img {
            transition: transform 0.6s ease;
        }

        .gaming-card:hover img {
            transform: scale(1.08);
        }
</style>

<!-- Thông báo lỗi nếu có -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm my-4" role="alert">
        <strong>⚠️ Thông báo:</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Nội dung Danh mục & Sản phẩm -->
<div class="row g-4 mt-2">
    <!-- Cột bên trái: Bộ lọc danh mục -->
    <div class="col-md-3">
        <div class="p-3 bg-white rounded-4 border shadow-sm">
            <div class="d-flex align-items-center mb-3">
                <div class="bg-primary rounded-pill me-2" style="width: 5px; height: 20px;"></div>
                <h5 class="fw-bold text-dark m-0">Danh mục sản phẩm</h5>
            </div>

            <div class="list-group filter-group border-0">
                <a asp-controller="Product" asp-action="Index"
                   class="list-group-item list-group-item-action @(!selectedCategoryId.HasValue ? "active" : "")">
                    🔥 Tất cả sản phẩm
                </a>
                @if (categories != null)
                {
                    @foreach (var cat in categories)
                    {
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id"
                           class="list-group-item list-group-item-action @(selectedCategoryId == cat.Id ? "active" : "")">
                            @cat.Name
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Cột bên phải: Lưới danh sách sản phẩm -->
    <div class="col-md-9">

        <!-- BỘ SẮP XẾP SẢN PHẨM -->
        <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded-4 border shadow-sm">
            <span class="text-muted small fw-bold">⚡ Sắp xếp danh sách thiết bị</span>

            <div class="dropdown">
                <button class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-bold dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    ⚡ Sắp xếp theo
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                    <li><a class="dropdown-item fw-semibold" asp-controller="Product" asp-action="Index" asp-route-categoryId="@selectedCategoryId" asp-route-sortOrder="">🆕 Mới nhất</a></li>
                    <li><a class="dropdown-item fw-semibold" asp-controller="Product" asp-action="Index" asp-route-categoryId="@selectedCategoryId" asp-route-sortOrder="price_asc">📈 Giá: Thấp đến Cao</a></li>
                    <li><a class="dropdown-item fw-semibold" asp-controller="Product" asp-action="Index" asp-route-categoryId="@selectedCategoryId" asp-route-sortOrder="price_desc">📉 Giá: Cao xuống Thấp</a></li>
                    <li><a class="dropdown-item fw-semibold" asp-controller="Product" asp-action="Index" asp-route-categoryId="@selectedCategoryId" asp-route-sortOrder="name_az">🔤 Tên: A - Z</a></li>
                </ul>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 gaming-card shadow-sm overflow-hidden d-flex flex-column">
                            <div style="height: 190px; overflow: hidden; background: #f8fafc;" class="position-relative d-flex align-items-center justify-content-center p-3">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/300" : item.ImageUrl)"
                                     class="card-img-top rounded" alt="@item.Name" style="max-height: 100%; object-fit: contain;">
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-dark fw-bold mb-1" style="font-size: 0.95rem;">@item.Name</h6>

                                <!-- 🌟 HIỂN THỊ SAO TRUNG BÌNH TRÊN THẺ SẢN PHẨM -->
                                <div class="mb-2 small text-warning" style="font-size: 0.78rem;">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(item.AverageRating))
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">☆</span>
                                        }
                                    }
                                    <span class="text-muted ms-1 fw-semibold">(@item.AverageRating) • @item.TotalReviews đánh giá</span>
                                </div>

                                <p class="card-text text-muted small flex-grow-1" style="font-size: 0.82rem;">
                                    @(item.Description != null && item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                                </p>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top border-light mb-2">
                                    <span class="text-danger fw-bold fs-6">@item.Price.ToString("N0") đ</span>

                                    @if (item.StockQuantity > 0)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1 small">
                                            Còn: @item.StockQuantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1 small">
                                            🚫 Hết hàng
                                        </span>
                                    }
                                </div>

                                @if (item.StockQuantity > 0)
                                {
                                    <div class="d-flex align-items-center justify-content-between mb-2 bg-light p-2 rounded-3 border">
                                        <span class="small text-muted fw-bold">Số lượng:</span>
                                        <input type="number" value="1" min="1" max="@item.StockQuantity"
                                               class="form-control form-control-sm text-center fw-bold bg-white"
                                               style="width: 70px;"
                                               oninput="document.getElementById('qty-cart-@item.Id').value = this.value; document.getElementById('qty-buynow-@item.Id').value = this.value;" />
                                    </div>
                                }

                                <div class="d-flex gap-1 mt-auto">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-dark flex-fill fw-bold py-2 px-1 btn-sm rounded-pill"
                                       style="font-size: 0.78rem;" title="Xem chi tiết">
                                        🔍 Chi tiết
                                    </a>

                                    @if (item.StockQuantity > 0)
                                    {
                                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                                        {
                                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-fill">
                                                <input type="hidden" name="productId" value="@item.Id" />
                                                <input type="hidden" id="qty-cart-@item.Id" name="quantity" value="1" />
                                                <button type="submit" class="btn btn-warning w-100 fw-bold py-2 px-1 btn-sm rounded-pill text-dark shadow-sm" style="font-size: 0.78rem;" title="Thêm vào giỏ">
                                                    🛒 Giỏ
                                                </button>
                                            </form>

                                            <form asp-controller="Cart" asp-action="BuyNow" method="post" class="flex-fill">
                                                <input type="hidden" name="productId" value="@item.Id" />
                                                <input type="hidden" id="qty-buynow-@item.Id" name="quantity" value="1" />
                                                <button type="submit" class="btn btn-danger w-100 fw-bold py-2 px-1 btn-sm rounded-pill text-white shadow-sm" style="font-size: 0.78rem;" title="Mua ngay">
                                                    ⚡ Mua
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a asp-controller="Account" asp-action="Login" class="btn btn-warning flex-fill fw-bold py-2 px-1 btn-sm rounded-pill text-dark shadow-sm" style="font-size: 0.78rem;" onclick="return confirm('Bạn cần đăng nhập để thêm sản phẩm vào giỏ hàng!');" title="Đăng nhập">
                                                🛒 Giỏ
                                            </a>
                                            <a asp-controller="Account" asp-action="Login" class="btn btn-danger flex-fill fw-bold py-2 px-1 btn-sm rounded-pill text-white shadow-sm" style="font-size: 0.78rem;" onclick="return confirm('Bạn cần đăng nhập để mua hàng!');" title="Đăng nhập">
                                                ⚡ Mua
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary flex-fill fw-bold py-2 px-1 btn-sm rounded-pill" disabled style="font-size: 0.78rem;">
                                            ❌ Hết
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 bg-white rounded-4 border">
                    <p class="fs-5 text-muted mb-0">Chưa có sản phẩm nào thuộc danh mục này.</p>
                </div>
            }
        </div>
    </div>
</div>