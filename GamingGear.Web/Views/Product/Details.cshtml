@model GamingGear.Domain.Entities.Product

@{
    ViewData["Title"] = Model.Name + " - Ambition Karma Shop";

    // Tính toán số sao trung bình từ Feedbacks thực tế của sản phẩm
    var feedbackList = Model.Feedbacks ?? new List<GamingGear.Domain.Entities.Feedback>();
    int totalReviews = feedbackList.Count;
    double avgRating = totalReviews > 0 ? feedbackList.Average(f => f.Rating) : 0;
}

<style>
    body {
        background-color: #f8fafc;
        color: #1e293b;
    }

    .product-details-container {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.5rem;
        box-shadow: 0 15px 35px rgba(15, 23, 42, 0.05);
    }

    .product-image-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        overflow: hidden;
        position: relative;
    }

        .product-image-box img {
            transition: transform 0.5s ease;
        }

        .product-image-box:hover img {
            transform: scale(1.05);
        }

    .btn-buy-now {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.3);
        transition: all 0.3s ease;
    }

        .btn-buy-now:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
        }

    .btn-back {
        border: 1px solid #cbd5e1;
        transition: all 0.2s ease;
    }

        .btn-back:hover {
            background-color: #f1f5f9;
            border-color: #94a3b8;
        }
</style>

<!-- Thanh điều hướng breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4 mt-2">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index" class="text-decoration-none">Sản phẩm</a></li>
        <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<!-- Giao diện chi tiết sản phẩm -->
<div class="p-4 p-lg-5 mb-5 product-details-container">
    <div class="row g-5 align-items-center">
        <!-- Cột hình ảnh -->
        <div class="col-lg-6">
            <div class="product-image-box p-4 text-center d-flex align-items-center justify-content-center" style="min-height: 380px;">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/400" : Model.ImageUrl)"
                     alt="@Model.Name"
                     class="img-fluid rounded"
                     style="max-height: 350px; object-fit: contain;" />
            </div>
        </div>

        <!-- Cột thông tin -->
        <div class="col-lg-6">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 mb-3 fw-bold rounded-pill text-uppercase">⚡ Thiết bị Gaming chính hãng</span>

            <h2 class="fw-bold text-dark mb-3">@Model.Name</h2>

            <!-- 🌟 HIỂN THỊ ĐIỂM SAO TRUNG BÌNH TỪ FEEDBACK THỰC TẾ -->
            <div class="mb-3 d-flex align-items-center gap-2">
                <div class="text-warning fs-5">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(avgRating))
                        {
                            <span>★</span>
                        }
                        else
                        {
                            <span class="text-muted">☆</span>
                        }
                    }
                </div>
                <span class="fw-bold text-dark">@avgRating.ToString("0.0") / 5.0</span>
                <span class="text-muted small">(@totalReviews đánh giá từ khách hàng)</span>
            </div>

            <div class="mb-3">
                <span class="text-danger fw-bold fs-3">@Model.Price.ToString("N0") đ</span>
            </div>

            <p class="text-secondary mb-4 lh-lg">
                @Model.Description
            </p>

            <div class="mb-4 p-3 bg-light rounded-3 border">
                <p class="mb-1 small text-muted">
                    <strong>Tình trạng kho:</strong>
                    @if (Model.StockQuantity > 0)
                    {
                        <span class="text-success fw-bold">Còn hàng (@Model.StockQuantity sản phẩm)</span>
                    }
                    else
                    {
                        <span class="text-danger fw-bold">🚫 Tạm hết hàng</span>
                    }
                </p>
                <p class="mb-0 small text-muted"><strong>Bảo hành:</strong> Chính hãng 24 tháng - Đổi mới 30 ngày đầu.</p>
            </div>

            <!-- CÁC NÚT HÀNH ĐỘNG PHÂN QUYỀN -->
            <div class="d-flex gap-3 pt-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <div class="alert alert-warning text-dark w-100 mb-0 rounded-4 p-3 d-flex align-items-center gap-2 shadow-sm">
                        <span class="fs-4">🛡️</span>
                        <div>
                            <strong>Tài khoản Quản trị viên:</strong> Bạn chỉ có quyền xem và quản lý danh mục sản phẩm, không thể thực hiện chức năng mua hàng.
                        </div>
                    </div>
                }
                else
                {
                    @if (Model.StockQuantity > 0)
                    {
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex-grow-1">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-buy-now text-white w-100 py-3 fw-bold rounded-pill">
                                🛒 THÊM VÀO GIỎ HÀNG
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary flex-grow-1 py-3 fw-bold rounded-pill" disabled>
                            ❌ SẢN PHẨM TẠM HẾT HÀNG
                        </button>
                    }
                }

                <a asp-controller="Product" asp-action="Index" class="btn btn-back text-dark px-4 py-3 fw-bold rounded-pill d-flex align-items-center justify-content-center text-nowrap">
                    ← Quay lại
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ================= PHẦN ĐÁNH GIÁ & FEEDBACK KHÁCH HÀNG ================= -->
<div class="p-4 p-lg-5 mb-5 product-details-container">
    <h4 class="fw-bold mb-4">💬 Đánh giá & Phản hồi sản phẩm (@totalReviews)</h4>

    @if (TempData["SuccessFeedback"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessFeedback"]</div>
    }
    @if (TempData["ErrorFeedback"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorFeedback"]</div>
    }

    <!-- Form gửi đánh giá -->
    @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
    {
        <div class="card p-4 mb-4 shadow-sm border bg-light rounded-4">
            <form asp-controller="Feedback" asp-action="Create" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Đánh giá số sao:</label>
                    <select name="rating" class="form-select w-auto">
                        <option value="5">⭐⭐⭐⭐⭐ (5/5 - Tuyệt vời)</option>
                        <option value="4">⭐⭐⭐⭐ (4/5 - Hài lòng)</option>
                        <option value="3">⭐⭐⭐ (3/5 - Bình thường)</option>
                        <option value="2">⭐⭐ (2/5 - Tạm được)</option>
                        <option value="1">⭐ (1/5 - Kém)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Nội dung:</label>
                    <textarea name="comment" class="form-control" rows="3" placeholder="Viết cảm nhận của bạn về sản phẩm..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary fw-bold px-4 rounded-pill">Gửi đánh giá</button>
            </form>
        </div>
    }
    else if (!User.Identity?.IsAuthenticated ?? true)
    {
        <div class="alert alert-info">
            Vui lòng <a asp-controller="Account" asp-action="Login">Đăng nhập</a> để viết đánh giá sản phẩm này.
        </div>
    }

    <!-- Danh sách hiển thị feedback -->
    <div class="feedbacks-list">
        @if (feedbackList.Any())
        {
            @foreach (var fb in feedbackList)
            {
                <div class="card mb-3 border-0 shadow-sm p-3 rounded-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold mb-0 text-primary">@(string.IsNullOrEmpty(fb.CustomerName) ? "Khách hàng" : fb.CustomerName)</h6>
                        <small class="text-muted">@fb.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="text-warning mb-2">
                        @for (int i = 0; i < fb.Rating; i++)
                        {
                            <span>⭐</span>
                        }
                    </div>
                    <p class="mb-2 text-dark">@fb.Comment</p>

                    @if (!string.IsNullOrEmpty(fb.AdminReply))
                    {
                        <div class="bg-light p-3 rounded-3 mt-2 border-start border-4 border-primary">
                            <small class="text-primary fw-bold">⚡ Phản hồi từ Quản trị viên Ambition Karma:</small>
                            <p class="mb-0 text-secondary mt-1">@fb.AdminReply</p>
                        </div>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <form asp-controller="Feedback" asp-action="AdminReply" method="post" class="mt-3 pt-2 border-top">
                            <input type="hidden" name="feedbackId" value="@fb.Id" />
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="input-group input-group-sm">
                                <input type="text" name="adminReply" class="form-control" placeholder="Nhập phản hồi với tư cách Quản trị viên..." value="@fb.AdminReply" required />
                                <button type="submit" class="btn btn-dark fw-bold px-3">Gửi phản hồi</button>
                            </div>
                        </form>
                    }
                </div>
            }
        }
        else
        {
            <p class="text-muted fst-italic">Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên đánh giá!</p>
        }
    </div>
</div>