@model GamingGear.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký tài khoản - Ambition Karma Shop";
}

<style>
    body {
        background-color: #f8fafc;
        color: #1e293b;
    }

    .register-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.5rem;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.08);
    }

    .btn-register {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        transition: all 0.3s ease;
    }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.45);
        }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="p-5 register-card">
                <div class="text-center mb-4">
                    <span class="badge bg-success text-white px-3 py-2 mb-2 fw-bold text-uppercase">✨ TẠO TÀI KHOẢN MỚI</span>
                    <h3 class="fw-bold text-dark">Đăng Ký Thành Viên</h3>
                    <p class="text-muted small">Tham gia Ambition Karma Shop ngay hôm nay</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên</label>
                        <input asp-for="FullName" class="form-control rounded-pill px-3 py-2" placeholder="Nguyễn Văn A" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email tài khoản</label>
                        <input asp-for="Email" class="form-control rounded-pill px-3 py-2" placeholder="user@gmail.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                        <input asp-for="Password" class="form-control rounded-pill px-3 py-2" type="password" placeholder="Mật khẩu tối thiểu 6 ký tự" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu</label>
                        <input asp-for="ConfirmPassword" class="form-control rounded-pill px-3 py-2" type="password" placeholder="Nhập lại mật khẩu" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-register text-white w-100 py-3 fw-bold rounded-pill mb-3">
                        🚀 ĐĂNG KÝ NGAY
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">Đã có tài khoản?</span>
                        <a asp-controller="Account" asp-action="Login" class="fw-bold text-primary text-decoration-none small">Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>