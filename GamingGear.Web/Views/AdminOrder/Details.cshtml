@model GamingGear.Domain.Entities.Order

@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id} (Quản trị)";
    var orderDetails = ViewBag.OrderDetails as List<GamingGear.Domain.Entities.OrderDetail> ?? Model.OrderDetails?.ToList() ?? new List<GamingGear.Domain.Entities.OrderDetail>();
    var products = ViewBag.Products as Dictionary<int, GamingGear.Domain.Entities.Product> ?? new Dictionary<int, GamingGear.Domain.Entities.Product>();
}

<div class="container my-4">
    <!-- Hiển thị thông báo thành công / lỗi -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <strong>Thành công:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <strong>Thông báo:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">⚡ CHI TIẾT ĐƠN HÀNG #@Model.Id</h2>
        <div>
            <!-- ⚡ NÚT IN HÓA ĐƠN -->
            <a asp-action="PrintInvoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-dark rounded-pill px-4 fw-bold shadow-sm me-2">
                🖨️ In hóa đơn
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold">← Quay lại danh sách</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột trái: Thông tin nhận hàng và Trạng thái -->
        <div class="col-lg-6">
            <div class="p-4 bg-white border rounded-4 shadow-sm mb-4">
                <h5 class="fw-bold text-dark mb-3">📋 Thông tin nhận hàng</h5>
                <p class="mb-2"><strong>Khách hàng:</strong> @Model.FullName</p>
                <p class="mb-2"><strong>Số điện thoại:</strong> @Model.PhoneNumber</p>
                <p class="mb-2"><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                <p class="mb-2"><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>

                <!-- ⚡ HIỂN THỊ PHƯƠNG THỨC THANH TOÁN RÕ RÀNG CHO ADMIN -->
                <p class="mb-2">
                    <strong>Phương thức thanh toán:</strong>
                    @if (Model.PaymentMethod == "VNPAY" || Model.Status == "Pending_Payment")
                    {
                        <span class="badge bg-warning text-dark px-2 py-1">💳 Chuyển khoản QR (Online)</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark px-2 py-1">📦 Thanh toán khi nhận hàng (COD)</span>
                    }
                </p>

                <p class="mb-0"><strong>Tổng tiền đơn hàng:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</span></p>
            </div>

            <div class="p-4 bg-white border rounded-4 shadow-sm">
                <h5 class="fw-bold text-dark mb-3">⚙️ Trạng thái đơn hàng</h5>
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <select name="status" class="form-select rounded-pill">
                            <option value="Pending" selected="@(Model.Status == "Pending")">Chờ xử lý</option>
                            <option value="Processing" selected="@(Model.Status == "Processing")">Đang chuẩn bị</option>
                            <option value="Shipped" selected="@(Model.Status == "Shipped")">Đang giao hàng</option>
                            <option value="Completed" selected="@(Model.Status == "Completed" || Model.Status == "Hoàn tất")">Hoàn tất</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Đã hủy</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2">Cập nhật trạng thái</button>
                </form>
            </div>
        </div>

        <!-- Cột phải: Sản phẩm trong đơn & Chi tiết khấu trừ -->
        <div class="col-lg-6">
            <div class="p-4 bg-white border rounded-4 shadow-sm mb-4">
                <h5 class="fw-bold text-dark mb-3">📦 Sản phẩm trong đơn</h5>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (orderDetails != null && orderDetails.Any())
                            {
                                foreach (var detail in orderDetails)
                                {
                                    var prod = detail.Product ?? (products.ContainsKey(detail.ProductId) ? products[detail.ProductId] : null);
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <img src="@(string.IsNullOrEmpty(prod?.ImageUrl) ? "https://via.placeholder.com/40" : prod.ImageUrl)"
                                                     class="rounded border"
                                                     style="width: 40px; height: 40px; object-fit: contain;" />
                                                <span class="small fw-semibold text-dark text-truncate" style="max-width: 140px;">
                                                    @(prod?.Name ?? $"Sản phẩm #{detail.ProductId}")
                                                </span>
                                            </div>
                                        </td>
                                        <td class="text-center small">@detail.UnitPrice.ToString("N0") đ</td>
                                        <td class="text-center small">@detail.Quantity</td>
                                        <td class="text-end small fw-bold text-danger">@((detail.UnitPrice * detail.Quantity).ToString("N0")) đ</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted small py-3">Không tìm thấy chi tiết sản phẩm trong đơn.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 💰 Chi tiết khấu trừ & Thanh toán -->
            <div class="p-4 bg-white border rounded-4 shadow-sm">
                <h5 class="fw-bold text-dark mb-3">💰 Chi tiết khấu trừ & Thanh toán</h5>

                <div class="d-flex justify-content-between mb-2 text-secondary">
                    <span>Tạm tính tiền hàng:</span>
                    <span class="fw-bold text-dark">@((Model.TotalAmount + Model.DiscountAmount - Model.ShippingFee).ToString("N0")) đ</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.CouponCode))
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>Mã khuyến mãi: <strong class="badge bg-danger">@Model.CouponCode</strong></span>
                        <span class="fw-bold">-@Model.DiscountAmount.ToString("N0") đ</span>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Mã khuyến mãi:</span>
                        <span>Không sử dụng</span>
                    </div>
                }

                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom text-secondary">
                    <span>Phí vận chuyển:</span>
                    <span class="fw-bold text-dark">@(Model.ShippingFee == 0 ? "Miễn phí (0 đ)" : $"{Model.ShippingFee:N0} đ")</span>
                </div>

                <div class="d-flex justify-content-between mb-2 text-secondary">
                    <span class="fw-bold text-dark">Tổng khách phải trả:</span>
                    <span class="fw-bold text-danger">@Model.TotalAmount.ToString("N0") đ</span>
                </div>

                <!-- ⚡ SỐ TIỀN THU HỘ CỦA SHIPPER (COD) THỰC TẾ -->
                <div class="d-flex justify-content-between fs-5 pt-2 border-top">
                    <span class="fw-bold text-dark">THU KHÁCH KHI GIAO HÀNG (COD):</span>
                    <span class="fw-bold text-danger fs-4">
                        @if (Model.PaymentMethod == "VNPAY" || Model.Status == "Pending_Payment")
                        {
                            <text>0 đ <small class="text-muted fw-normal" style="font-size: 0.8rem;">(Đã chuyển khoản online)</small></text>
                        }
                        else
                        {
                            @($"{Model.TotalAmount:N0} đ")
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>